@{
    ViewData["Title"] = "Promedio";
}

<style>
    body {
        background-color: #dcdcdc;
        font-family: Arial, Helvetica, sans-serif;
    }

    .contenedor {
        margin: 60px auto;
    }

    .fila {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    label {
        width: 80px;
        font-size: 16px;
    }

    input[type="number"] {
        width: 130px;
        height: 35px;
        border: 1px solid #666;
        font-size: 18px;

    }

    .separacion-derecha {
        margin-left: 60px;
    }

    .nota1 {
        background-color: #63a70a;
        color: white;
        padding-left: 5px;
    }

    .nota2 {
        background-color: #eeeeee;
        padding-left: 25px;
    }

    .nota3 {
        background-color: #eeeeee;
        color: red;
        padding-left: 5px;
    }

    .nota4 {
        background-color: #f2ef8c;
        padding-left: 25px;
    }

    .botones {
        display: flex;
        gap: 60px;
        margin-top: 20px;
    }

    button {
        width: 150px;
        height: 50px;
        border-radius: 12px;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: white;
        background-color: #1e88e5;
    }

    .promedio-fila {
        margin-top: 40px;
        display: flex;
        align-items: center;
    }

    .promedio-input {
        background-color: #d9d9d9;
    }
</style>

<div class="contenedor">

    <form asp-action="Index" method="post">

        <div class="fila">
            <label>Nota 1</label>
            <input type="number" name="nota1" class="nota1" value="@ViewBag.Nota1" required />

            <label class="separacion-derecha">Nota 2</label>
            <input type="number" name="nota2" class="nota2" value="@ViewBag.Nota2" required />
        </div>

        <div class="fila">
            <label>Nota 3</label>
            <input type="number" name="nota3" class="nota3" value="@ViewBag.Nota3" required />

            <label class="separacion-derecha">Nota 4</label>
            <input type="number" name="nota4" class="nota4" value="@ViewBag.Nota4" required />
        </div>

        <div class="botones">
            <button type="submit">Calcular</button>
            <button type="button" onclick="limpiarCampos()">Limpiar</button>
        </div>

        <div class="promedio-fila">
            <label>Promedio</label>
            <input type="text" class="promedio-input" value="@ViewBag.Promedio" disabled />
        </div>

    </form>

</div>

<script>
    function limpiarCampos() {
        document.querySelectorAll('input[type="number"]').forEach(input => input.value = '');
        document.querySelector('.promedio-input').value = '';
    }
</script>
